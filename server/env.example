# Copy to /etc/mr-roboto.env (chmod 600). Never commit the real file.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
# Seconds to wait for a draft. CPU-only models can take 15+ minutes.
LLM_TIMEOUT=3600
BLOG_INBOX=/srv/mr-roboto/inbox
STUDY_DIR=/srv/mr-roboto/private/study-resources
# Extra comma-separated regexes the scanner must never allow in a post (e.g. employer or SSIDs).
BLOG_OWNER_PATTERNS=
# gh CLI auth: fine-grained token for the anonymous repo only (contents + pull requests).
GH_TOKEN=
